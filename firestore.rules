rules_version = '2';

// Firestore rules for Pacific Coast Trip.
// Public reads (so family can follow along), writes only for the trip owner.
// TODO: replace OWNER_UID with your actual UID after first anonymous sign-in.
service cloud.firestore {
  match /databases/{database}/documents {
    match /trips/pacific-coast/days/{dayId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == "OWNER_UID";
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

